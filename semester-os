#!/bin/sh
# Semester OS launcher for macOS, Linux and WSL.
#
#   ./semester-os setup    install everything (safe to repeat)
#   ./semester-os          start the app and open the browser
#   ./semester-os doctor   check the install
#
# This script only finds a Python 3.11 or newer and hands over to
# scripts/launcher.py, which does the real work with the standard library.
# Run ./semester-os --help for every command.

set -u

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
LAUNCHER="$ROOT/scripts/launcher.py"

python_is_recent() {
    "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

# An explicit choice first, then the newest versioned names, then the generic
# ones, and the app's own virtual environment last (it is 3.11+ by construction).
for candidate in "${SEMESTER_OS_PYTHON:-}" python3.14 python3.13 python3.12 python3.11 python3 python \
    "$ROOT/app/server/.venv/bin/python"; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1 && python_is_recent "$candidate"; then
        exec "$candidate" "$LAUNCHER" "$@"
    fi
done

# No suitable Python, but uv can bring its own.
if command -v uv >/dev/null 2>&1; then
    printf '%s\n' "No Python 3.11+ on PATH; using a Python managed by uv."
    exec uv run --no-project --quiet --python '>=3.11' "$LAUNCHER" "$@"
fi

printf '%s\n' "error: Semester OS needs Python 3.11 or newer, and none was found." >&2
case "$(uname -s 2>/dev/null)" in
    Darwin)
        printf '%s\n' \
            "  Install it with Homebrew:  brew install python@3.12" \
            "  or from https://www.python.org/downloads/" >&2
        ;;
    *)
        printf '%s\n' \
            "  Ubuntu 24.04 or newer:     sudo apt install python3 python3-venv" >&2
        ;;
esac
printf '%s\n' \
    "  Or install uv, which fetches Python for you, then run this again:" \
    "    curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
exit 2
