# Semester OS

# Local configuration. config.example.yaml is committed; config.yaml carries
# calendar feed URLs, which are credentials.
config.yaml

# Everything the app writes at runtime: the SQLite database, the API token,
# Google OAuth client and tokens, harvested course notes and syllabi.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
.semester_os_token
.google_oauth_client.json
.google_token.json

# The folder a student drops their syllabi into. A syllabus names real people.
# The invented samples in examples/syllabi/ are committed.
/syllabi/

# Secrets
.env
.env.*
.mcp.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node and build output
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# OS and editor junk
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
